# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database
DATABASE_URL=your_database_url_here

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_monthly_subscription_price_id

# Email Service (Postmark/Resend)
POSTMARK_API_KEY=your_postmark_api_key_here
# OR
RESEND_API_KEY=your_resend_api_key_here

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# File Storage (AWS S3 or compatible)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET_NAME=your_s3_bucket_name_here
AWS_REGION=us-east-1

# Calendly API
CALENDLY_API_KEY=your_calendly_api_key_here
CALENDLY_USER_URI=your_calendly_user_uri_here

# Dropbox Sign
DROPBOX_SIGN_API_KEY=your_dropbox_sign_api_key_here

# Background Check Services
CHECKR_API_KEY=your_checkr_api_key_here
CHECKR_WEBHOOK_SECRET=your_checkr_webhook_secret_here

# License Verification Services
NURSYS_API_KEY=your_nursys_api_key_here
NURSYS_WEBHOOK_SECRET=your_nursys_webhook_secret_here

# Analytics
RUDDERSTACK_WRITE_KEY=your_rudderstack_write_key_here
RUDDERSTACK_DATA_PLANE_URL=your_rudderstack_data_plane_url_here

# Encryption
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Application Configuration
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development 